    </div>

    <div class="footer-newsletter">

      <h2>Newsletter</h2>

      <p>
        Receba dicas exclusivas e novidades
        direto no seu e-mail!
      </p>

      <form id="newsletter-form" novalidate>

        <label class="sr-only" for="newsletter-email">
          Seu melhor e-mail
        </label>

        <div class="newsletter-form-row">

          <input
            type="email"
            id="newsletter-email"
            placeholder="Seu melhor e-mail"
            required
          >

          <button type="submit">
            Inscrever-se
          </button>

        </div>

        <p
          class="newsletter-feedback"
          id="newsletter-feedback"
          aria-live="polite"
        ></p>

      </form>

    </div>

    <div class="footer-quote">
      <span>Beleza começa</span>
      <span>quando você</span>
      <span>se escolhe! <b>♥</b></span>
    </div>

  </div>

