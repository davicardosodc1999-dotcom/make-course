<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sobre Nós | Beleza em Foco</title>

  <meta
    name="description"
    content="Conheça o Beleza em Foco, um portal brasileiro sobre maquiagem, autocuidado, beleza, educação e confiança."
  >

  <link rel="canonical" href="https://seudominio.com/about.html">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@500;600;700;800;900&family=Playfair+Display:ital,wght@1,700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/responsive.css">

  <script src="js/main.js" defer></script>
  <script src="js/search.js" defer></script>
  <script src="js/favorites.js" defer></script>
  <script src="js/consent.js" defer></script>

  <style>
    .institutional-page {
      min-height: 70vh;
      padding: 38px 0 60px;
      background:
        radial-gradient(circle at 10% 4%, rgba(255,15,104,.07), transparent 24%),
        radial-gradient(circle at 92% 6%, rgba(120,37,198,.07), transparent 26%),
        linear-gradient(180deg, #fff 0%, #fff8fb 100%);
    }

    .institutional-hero {
      position: relative;
      overflow: hidden;
      padding: 36px 40px;
      border-radius: 18px;
      color: #fff;
      background:
        radial-gradient(circle at 86% 18%, rgba(255,173,0,.48), transparent 22%),
        linear-gradient(120deg, #ff0f68 0%, #d40b70 50%, #63148f 100%);
      box-shadow: 0 15px 38px rgba(75,13,104,.14);
    }

    .institutional-hero::before {
      content: "";
      position: absolute;
      right: -80px;
      bottom: -120px;
      width: 240px;
      height: 240px;
      border: 28px solid rgba(255,255,255,.07);
      border-radius: 50%;
    }

    .institutional-hero-content {
      position: relative;
      z-index: 2;
      max-width: 820px;
    }

    .institutional-label {
      display: inline-flex;
      min-height: 27px;
      padding: 0 12px;
      align-items: center;
      border-radius: 16px;
      background: rgba(255,255,255,.15);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: .8px;
      text-transform: uppercase;
    }

    .institutional-hero h1 {
      margin-top: 10px;
      font-family: "Montserrat", sans-serif;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.08;
      font-weight: 900;
    }

    .institutional-hero p {
      margin-top: 12px;
      max-width: 760px;
      color: rgba(255,255,255,.94);
      font-size: 14px;
      line-height: 1.7;
    }

    .institutional-content {
      margin-top: 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 26px;
      align-items: start;
    }

    .institutional-main {
      padding: 28px 30px;
      border: 1px solid rgba(210,50,110,.12);
      border-radius: 15px;
      background: #fff;
      box-shadow: 0 9px 26px rgba(70,20,70,.07);
    }

    .institutional-main section + section {
      margin-top: 28px;
    }

    .institutional-main h2 {
      color: #32123d;
      font-family: "Montserrat", sans-serif;
      font-size: 21px;
      line-height: 1.25;
      font-weight: 900;
    }

    .institutional-main h3 {
      margin-top: 18px;
      color: #4b0d68;
      font-family: "Montserrat", sans-serif;
      font-size: 15px;
      font-weight: 800;
    }

    .institutional-main p {
      margin-top: 10px;
      color: #55495a;
      font-size: 12.5px;
      line-height: 1.8;
    }

    .institutional-main ul {
      margin-top: 12px;
      padding-left: 20px;
      list-style: disc;
      color: #55495a;
    }

    .institutional-main li {
      margin-bottom: 8px;
      font-size: 12px;
      line-height: 1.7;
    }

    .institutional-highlight {
      margin-top: 18px;
      padding: 16px 18px;
      border-left: 4px solid #ff0f68;
      border-radius: 9px;
      background: #fff3f8;
      color: #513d52;
      font-size: 11.5px;
      line-height: 1.7;
    }

    .about-values {
      margin-top: 18px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .about-value {
      padding: 16px;
      border: 1px solid rgba(210,50,110,.12);
      border-radius: 11px;
      background: #fff9fc;
    }

    .about-value-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: #fff;
      background: linear-gradient(135deg, #ff0f68, #d40b70);
      font-size: 18px;
      margin-bottom: 10px;
    }

    .about-value:nth-child(even) .about-value-icon {
      background: linear-gradient(135deg, #7825c6, #4b0d68);
    }

    .about-value strong {
      display: block;
      color: #32123d;
      font-size: 11px;
    }

    .about-value p {
      margin-top: 5px;
      color: #6c6170;
      font-size: 9.5px;
      line-height: 1.55;
    }

    .institutional-sidebar-card {
      padding: 19px;
      border: 1px solid rgba(210,50,110,.12);
      border-radius: 13px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(70,20,70,.08);
    }

    .institutional-sidebar-card + .institutional-sidebar-card {
      margin-top: 13px;
    }

    .institutional-sidebar-card h2 {
      color: #32123d;
      font-family: "Montserrat", sans-serif;
      font-size: 14px;
      font-weight: 900;
    }

    .institutional-sidebar-card p {
      margin-top: 8px;
      color: #6c6170;
      font-size: 10px;
      line-height: 1.6;
    }

    .institutional-sidebar-links {
      margin-top: 12px;
      display: grid;
      gap: 6px;
    }

    .institutional-sidebar-links a {
      min-height: 36px;
      padding: 0 11px;
      border-radius: 7px;
      background: #fff4f8;
      color: #d40b70;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 9px;
      font-weight: 900;
    }

    .institutional-cta {
      margin-top: 13px;
      width: 100%;
      min-height: 41px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ff0f68, #d40b70);
      color: #fff;
      font-size: 10px;
      font-weight: 900;
    }

    @media (max-width: 850px) {
      .institutional-content {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 580px) {
      .institutional-page {
        padding-top: 20px;
      }

      .institutional-hero {
        padding: 26px 21px;
      }

      .institutional-main {
        padding: 22px 19px;
      }

      .about-values {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

