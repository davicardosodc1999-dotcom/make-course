</footer>

<div
  class="cookie-banner"
  id="cookie-banner"
  role="dialog"
  aria-label="Preferências de cookies"
  hidden
>

  <div class="cookie-content">

    <div>

      <strong>Privacidade e cookies</strong>

      <p>
        Usamos cookies para melhorar sua experiência,
        analisar o uso do site e preparar recursos de publicidade.
      </p>

      <a href="cookies.html">
        Política de Cookies
      </a>

    </div>

    <div class="cookie-actions">

      <button
        type="button"
        class="cookie-settings"
        id="cookie-settings"
      >
        Configurar
      </button>

      <button
        type="button"
        class="cookie-reject"
        id="cookie-reject"
      >
        Rejeitar não essenciais
      </button>

      <button
        type="button"
        class="cookie-accept"
        id="cookie-accept"
      >
        Aceitar
      </button>

    </div>

  </div>

</div>

