  <main id="conteudo-principal" class="categories-page">

    <div class="container">

      <section class="categories-hero">

        <div class="categories-hero-content">

          <span class="categories-kicker">
            ✦ ENCONTRE SEU TEMA
          </span>

          <h1>Explore nossas categorias</h1>

          <p>
            Navegue pelos principais temas do Beleza em Foco e encontre
            conteúdos para aprender novas técnicas, aprimorar sua maquiagem
            e descobrir inspirações para todos os estilos.
          </p>

        </div>

      </section>

      <div class="categories-intro">

        <div>
          <h2>Escolha uma categoria</h2>
          <p>
            Cada categoria leva diretamente aos artigos relacionados.
          </p>
        </div>

        <a href="artigos.html">
          Ver todos os 50 artigos →
        </a>

      </div>

      <section class="category-card-grid" aria-label="Categorias">

        <a
          href="artigos.html?categoria=iniciantes"
          class="category-card"
        >
          <div class="category-card-icon icon-pink">✦</div>

          <h3>Maquiagem para Iniciantes</h3>

          <p>
            Conteúdos para quem está começando e quer aprender
            maquiagem passo a passo desde a base.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Guias básicos</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=pele"
          class="category-card"
        >
          <div class="category-card-icon icon-orange">◇</div>

          <h3>Pele</h3>

          <p>
            Preparação, base, corretivo, pó, blush, iluminador e
            técnicas para um acabamento mais bonito.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Pele perfeita</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=olhos"
          class="category-card"
        >
          <div class="category-card-icon icon-purple">◉</div>

          <h3>Olhos</h3>

          <p>
            Delineado, sombras, esfumado, cut crease, smokey eye
            e combinações de cores.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Olhar em destaque</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=sobrancelhas"
          class="category-card"
        >
          <div class="category-card-icon icon-pink">⌁</div>

          <h3>Sobrancelhas</h3>

          <p>
            Design, mapeamento, preenchimento natural, correções
            e produtos essenciais.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Design e técnica</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=cilios"
          class="category-card"
        >
          <div class="category-card-icon icon-purple">✧</div>

          <h3>Cílios</h3>

          <p>
            Aplicação de cílios postiços, ajustes, remoção,
            formatos e técnicas com máscara.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Cílios marcantes</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=labios"
          class="category-card"
        >
          <div class="category-card-icon icon-pink">♥</div>

          <h3>Lábios</h3>

          <p>
            Batom, contorno labial, gloss, acabamento matte
            e técnicas para valorizar o formato dos lábios.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Cores e acabamento</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=produtos"
          class="category-card"
        >
          <div class="category-card-icon icon-orange">♙</div>

          <h3>Ferramentas</h3>

          <p>
            Pincéis, esponjas, organização, higiene e montagem
            de um kit de maquiagem funcional.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Produtos essenciais</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=tutoriais"
          class="category-card"
        >
          <div class="category-card-icon icon-pink">▶</div>

          <h3>Maquiagem Social</h3>

          <p>
            Looks para festas, casamentos, dia a dia, fotos
            e maquiagens glam completas.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Tutoriais completos</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=drag"
          class="category-card"
        >
          <div class="category-card-icon icon-purple">♛</div>

          <h3>Drag Queen</h3>

          <p>
            Contorno transformador, sobrancelhas, olhos dramáticos
            e construção de maquiagem drag.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Expressão e impacto</span>
          </div>
        </a>

        <a
          href="artigos.html?categoria=artistica"
          class="category-card"
        >
          <div class="category-card-icon icon-orange">✣</div>

          <h3>Maquiagem Artística</h3>

          <p>
            Primeiros passos, planejamento, criatividade,
            ferramentas e técnicas para explorar a maquiagem como arte.
          </p>

          <div class="category-card-footer">
            <span>Explorar →</span>
            <span class="category-card-count">Criatividade</span>
          </div>
        </a>

      </section>

    </div>

  </main>

