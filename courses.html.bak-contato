<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Categorias | Beleza em Foco</title>

  <meta
    name="description"
    content="Explore as categorias do Beleza em Foco: maquiagem para iniciantes, pele, olhos, sobrancelhas, cílios, lábios, ferramentas, maquiagem social, drag queen e maquiagem artística."
  >

  <link rel="canonical" href="https://seudominio.com/categorias.html">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@500;600;700;800;900&family=Playfair+Display:ital,wght@1,700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/responsive.css">

  <script src="js/main.js" defer></script>
  <script src="js/search.js" defer></script>
  <script src="js/favorites.js" defer></script>
  <script src="js/consent.js" defer></script>

  <style>
    .categories-page {
      min-height: 70vh;
      padding: 38px 0 58px;
      background:
        radial-gradient(circle at 12% 5%, rgba(255, 15, 104, .06), transparent 24%),
        radial-gradient(circle at 92% 8%, rgba(120, 37, 198, .07), transparent 25%),
        linear-gradient(180deg, #ffffff, #fff8fb);
    }

    .categories-hero {
      position: relative;
      overflow: hidden;
      padding: 34px 38px;
      margin-bottom: 28px;
      border-radius: 16px;
      color: #fff;
      background:
        radial-gradient(circle at 82% 20%, rgba(255, 173, 0, .45), transparent 22%),
        linear-gradient(120deg, #ff0f68 0%, #d40b70 46%, #63148f 100%);
      box-shadow: 0 14px 35px rgba(75, 13, 104, .14);
    }

    .categories-hero::before,
    .categories-hero::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
    }

    .categories-hero::before {
      width: 210px;
      height: 210px;
      right: 150px;
      bottom: -145px;
      border: 24px solid rgba(255,255,255,.08);
    }

    .categories-hero::after {
      width: 115px;
      height: 115px;
      right: 25px;
      top: -55px;
      background: rgba(255,173,0,.16);
    }

    .categories-hero-content {
      position: relative;
      z-index: 2;
      max-width: 760px;
    }

    .categories-kicker {
      display: inline-flex;
      align-items: center;
      min-height: 27px;
      padding: 0 12px;
      border-radius: 18px;
      background: rgba(255,255,255,.15);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .8px;
      margin-bottom: 10px;
    }

    .categories-hero h1 {
      font-family: "Montserrat", sans-serif;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.08;
      font-weight: 900;
    }

    .categories-hero p {
      max-width: 720px;
      margin-top: 10px;
      color: rgba(255,255,255,.94);
      font-size: 14px;
      line-height: 1.65;
    }

    .categories-intro {
      margin-bottom: 18px;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
    }

    .categories-intro h2 {
      font-family: "Montserrat", sans-serif;
      color: #32123d;
      font-size: 20px;
      font-weight: 900;
    }

    .categories-intro p {
      margin-top: 6px;
      color: #6c6170;
      font-size: 12px;
    }

    .categories-intro a {
      min-height: 36px;
      padding: 0 14px;
      border: 1px solid rgba(255, 15, 104, .3);
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      color: #ff0f68;
      font-size: 10px;
      font-weight: 900;
      white-space: nowrap;
    }

    .category-card-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 16px;
    }

    .category-card {
      position: relative;
      overflow: hidden;
      min-height: 220px;
      padding: 22px 18px 18px;
      border: 1px solid rgba(210, 50, 110, .12);
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(70, 20, 70, .08);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .category-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(70, 20, 70, .13);
    }

    .category-card::before {
      content: "";
      position: absolute;
      right: -35px;
      bottom: -45px;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: rgba(255, 15, 104, .05);
    }

    .category-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 22px;
      margin-bottom: 14px;
      box-shadow: 0 7px 18px rgba(75, 13, 104, .12);
    }

    .icon-pink {
      background: linear-gradient(135deg, #ff0f68, #d40b70);
    }

    .icon-purple {
      background: linear-gradient(135deg, #7825c6, #4b0d68);
    }

    .icon-orange {
      background: linear-gradient(135deg, #ffad00, #ff8a00);
    }

    .category-card h3 {
      position: relative;
      z-index: 2;
      font-family: "Montserrat", sans-serif;
      color: #32123d;
      font-size: 14px;
      line-height: 1.3;
      font-weight: 900;
    }

    .category-card p {
      position: relative;
      z-index: 2;
      margin-top: 8px;
      color: #6c6170;
      font-size: 10.5px;
      line-height: 1.55;
    }

    .category-card-footer {
      position: relative;
      z-index: 2;
      margin-top: 15px;
      padding-top: 11px;
      border-top: 1px solid #f1e6ec;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #d40b70;
      font-size: 9.5px;
      font-weight: 900;
    }

    .category-card-count {
      color: #7a6d7d;
      font-weight: 700;
    }

    @media (max-width: 1100px) {
      .category-card-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media (max-width: 900px) {
      .category-card-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
      .category-card-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .categories-intro {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 480px) {
      .categories-page {
        padding-top: 20px;
      }

      .categories-hero {
        padding: 25px 20px;
      }

      .category-card-grid {
        grid-template-columns: 1fr;
      }

      .category-card {
        min-height: 0;
      }
    }
  </style>
</head>

<body>

