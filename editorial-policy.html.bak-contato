<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Política Editorial | Beleza em Foco</title>

  <meta
    name="description"
    content="Conheça os princípios editoriais do Beleza em Foco, incluindo originalidade, revisão, correções, fontes, transparência, publicidade e responsabilidade com o leitor."
  >

  <link rel="canonical" href="https://seudominio.com/editorial-policy.html">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@500;600;700;800;900&family=Playfair+Display:ital,wght@1,700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/responsive.css">

  <script src="js/main.js" defer></script>
  <script src="js/search.js" defer></script>
  <script src="js/favorites.js" defer></script>
  <script src="js/consent.js" defer></script>

  <style>
    .legal-page {
      min-height: 70vh;
      padding: 38px 0 60px;
      background:
        radial-gradient(circle at 10% 4%, rgba(255,15,104,.07), transparent 24%),
        radial-gradient(circle at 92% 6%, rgba(120,37,198,.07), transparent 26%),
        linear-gradient(180deg, #fff 0%, #fff8fb 100%);
    }

    .legal-hero {
      position: relative;
      overflow: hidden;
      padding: 36px 40px;
      border-radius: 18px;
      color: #fff;
      background:
        radial-gradient(circle at 86% 18%, rgba(255,173,0,.48), transparent 22%),
        linear-gradient(120deg, #ff0f68 0%, #d40b70 50%, #63148f 100%);
      box-shadow: 0 15px 38px rgba(75,13,104,.14);
    }

    .legal-hero::before {
      content: "";
      position: absolute;
      right: -75px;
      bottom: -120px;
      width: 240px;
      height: 240px;
      border: 28px solid rgba(255,255,255,.07);
      border-radius: 50%;
    }

    .legal-hero-content {
      position: relative;
      z-index: 2;
      max-width: 820px;
    }

    .legal-label {
      display: inline-flex;
      min-height: 27px;
      padding: 0 12px;
      align-items: center;
      border-radius: 16px;
      background: rgba(255,255,255,.15);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: .8px;
      text-transform: uppercase;
    }

    .legal-hero h1 {
      margin-top: 10px;
      font-family: "Montserrat", sans-serif;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.08;
      font-weight: 900;
    }

    .legal-hero p {
      max-width: 760px;
      margin-top: 12px;
      color: rgba(255,255,255,.94);
      font-size: 14px;
      line-height: 1.7;
    }

    .legal-layout {
      margin-top: 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 26px;
      align-items: start;
    }

    .legal-content {
      padding: 28px 30px;
      border: 1px solid rgba(210,50,110,.12);
      border-radius: 15px;
      background: #fff;
      box-shadow: 0 9px 26px rgba(70,20,70,.07);
    }

    .legal-content section + section {
      margin-top: 28px;
    }

    .legal-content h2 {
      color: #32123d;
      font-family: "Montserrat", sans-serif;
      font-size: 20px;
      line-height: 1.3;
      font-weight: 900;
    }

    .legal-content h3 {
      margin-top: 17px;
      color: #4b0d68;
      font-family: "Montserrat", sans-serif;
      font-size: 14px;
      font-weight: 800;
    }

    .legal-content p {
      margin-top: 10px;
      color: #55495a;
      font-size: 12px;
      line-height: 1.8;
    }

    .legal-content ul {
      margin-top: 12px;
      padding-left: 20px;
      list-style: disc;
      color: #55495a;
    }

    .legal-content li {
      margin-bottom: 8px;
      font-size: 11.5px;
      line-height: 1.7;
    }

    .legal-highlight {
      margin-top: 18px;
      padding: 15px 17px;
      border-left: 4px solid #ff0f68;
      border-radius: 8px;
      background: #fff3f8;
      color: #513d52;
      font-size: 10.5px;
      line-height: 1.65;
    }

    .legal-note {
      margin-top: 18px;
      padding: 15px 17px;
      border-left: 4px solid #ffad00;
      border-radius: 8px;
      background: #fff8e9;
      color: #5b472c;
      font-size: 10px;
      line-height: 1.65;
    }

    .editorial-principles {
      margin-top: 16px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .editorial-principle {
      padding: 16px;
      border: 1px solid rgba(210,50,110,.12);
      border-radius: 10px;
      background: #fff8fb;
    }

    .editorial-principle strong {
      display: block;
      color: #32123d;
      font-size: 11px;
    }

    .editorial-principle p {
      margin-top: 5px;
      color: #6c6170;
      font-size: 9.5px;
      line-height: 1.55;
    }

    .legal-sidebar-card {
      position: sticky;
      top: 18px;
      padding: 18px;
      border: 1px solid rgba(210,50,110,.12);
      border-radius: 13px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(70,20,70,.08);
    }

    .legal-sidebar-card h2 {
      color: #32123d;
      font-family: "Montserrat", sans-serif;
      font-size: 14px;
      font-weight: 900;
    }

    .legal-sidebar-card p {
      margin-top: 7px;
      color: #6c6170;
      font-size: 9.5px;
      line-height: 1.6;
    }

    .legal-nav {
      margin-top: 12px;
      display: grid;
      gap: 6px;
    }

    .legal-nav a {
      min-height: 34px;
      padding: 0 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: 7px;
      background: #fff4f8;
      color: #d40b70;
      font-size: 8.8px;
      font-weight: 900;
    }

    .legal-date {
      margin-top: 15px;
      color: #837686;
      font-size: 8.5px;
      line-height: 1.5;
    }

    @media (max-width: 850px) {
      .legal-layout {
        grid-template-columns: 1fr;
      }

      .legal-sidebar-card {
        position: static;
      }
    }

    @media (max-width: 600px) {
      .editorial-principles {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 580px) {
      .legal-page {
        padding-top: 20px;
      }

      .legal-hero {
        padding: 26px 21px;
      }

      .legal-content {
        padding: 22px 19px;
      }
    }
  </style>
</head>

<body>

