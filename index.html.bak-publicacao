<script id="home-articles-sync">
document.addEventListener("DOMContentLoaded",function(){
const a=window.belezaEmFocoArticles||[];
if(!a.length)return;
function u(c,o,n){
if(!c||!o)return;
c.querySelectorAll("a").forEach(l=>l.href=o.url);
const t=c.querySelector("h2")||c.querySelector("h3")||c.querySelector(".article-title");
if(t){const l=t.querySelector("a");if(l){l.textContent=o.title;l.href=o.url}else{t.textContent=o.title}}
const g=c.querySelector(".article-category")||c.querySelector(".category");if(g)g.textContent=o.category;
const p=c.querySelector(".article-description")||c.querySelector(".article-card-body p")||c.querySelector("p");if(p)p.textContent=o.description;
const num=c.querySelector(".article-number");if(num)num.textContent=String(n+1).padStart(2,"0");
}
document.querySelectorAll(".article-grid .article-card").forEach((c,i)=>u(c,a[i],i));
document.querySelectorAll(".mini-article-card").forEach((c,i)=>u(c,a[i+4],i+4));
});
</script>


<script src="js/lipstick3d.js" defer></script>
<script id="home-all-articles">
document.addEventListener("DOMContentLoaded", () => {
  const articles = window.belezaEmFocoArticles || [];
  const grid = document.querySelector("#artigos-destaque .article-grid");
  if (!grid || !articles.length) return;

  grid.innerHTML = ""; const existing = new Set(
    [...grid.querySelectorAll("a[href]")].map(a => {
      try { return new URL(a.href, location.href).pathname.split("/").pop(); }
      catch(e) { return ""; }
    })
  );

  const categorySlug = value =>
    (value || "maquiagem")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  articles.forEach((article, index) => {
    const filename = (article.url || "").split("/").pop();
    if (!filename || existing.has(filename)) return;

    const number = String(index + 1).padStart(2, "0");
    const category = article.category || "Maquiagem";
    const slug = filename.replace(/\.html$/i, "");
    const image = `assets/img/articles/${slug}-capa.png`;

    const card = document.createElement("article");
    card.className = "article-card";
    card.dataset.category = categorySlug(category);
    card.dataset.articleId = article.id || number;

    card.innerHTML = `
      <a href="${article.url}" class="article-image-link">
        <div class="article-image-wrapper">
          <img
            src="${image}"
            alt="${article.title}"
            width="520"
            height="300"
            loading="lazy"
            onerror="if(!this.dataset.pngFallback){this.dataset.pngFallback='1';this.src=this.src.replace(/\.webp$/i,'.png')}else{this.style.visibility='hidden'}"
          >
          <span class="article-number">${number}</span>
          <span class="article-category">${category.toUpperCase()}</span>
        </div>
      </a>

      <div class="article-card-body">
        <button
          class="favorite-toggle"
          type="button"
          data-favorite-id="${article.id || number}"
          aria-label="Adicionar artigo aos favoritos"
        >♡</button>

        <h3>
          <a href="${article.url}">${article.title}</a>
        </h3>

        <p>${article.description || "Confira este guia completo de maquiagem e aprenda todas as etapas."}</p>
      </div>

      <div class="article-meta">
        <span><span aria-hidden="true">▣</span> Beleza em Foco</span>
        <span><span aria-hidden="true">◷</span> Guia completo</span>
      </div>
    `;

    grid.appendChild(card);
    existing.add(filename);
  });

  if (typeof updateFavoriteButtons === "function") {
    updateFavoriteButtons();
  }

  console.log("HOME: " + grid.querySelectorAll(".article-card").length + " artigos exibidos");
});
</script>
